<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>京都タクシー乗務用 イベント・催事ナビ</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        kyoto: {
                            red: '#9e2a2b',
                            gold: '#d4af37',
                            dark: '#121212',
                            cardDark: '#1e1e1e',
                            borderDark: '#2d2d2d'
                        }
                    }
                }
            }
        }
    </script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Lucide Icons (Fallback) -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        /* Touch friendly dynamic scrolling */
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        body { -webkit-tap-highlight-color: transparent; }
    </style>
</head>
<body class="bg-gray-100 dark:bg-kyoto-dark text-gray-800 dark:text-gray-100 font-sans antialiased min-h-screen transition-colors duration-200">

    <div id="app" class="max-w-md mx-auto min-h-screen flex flex-col bg-white dark:bg-kyoto-dark shadow-xl pb-20">

        <!-- HEADER -->
        <header class="sticky top-0 z-30 bg-gray-900 text-white px-4 py-3 shadow-md border-b border-amber-600/30 flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <i class="fa-solid font-bold text-amber-400 text-xl fa-taxi"></i>
                <div>
                    <h1 class="font-bold text-base leading-tight tracking-wide text-amber-400">京都乗務ナビ</h1>
                    <p class="text-[10px] text-gray-400">催事・学会・需要予測カレンダー</p>
                </div>
            </div>
            <div class="flex items-center space-x-2">
                <!-- Add Event Modal Trigger -->
                <button onclick="openAddModal()" class="bg-amber-500 hover:bg-amber-600 active:scale-95 text-gray-950 font-bold px-2.5 py-1.5 rounded-lg text-xs flex items-center shadow-sm">
                    <i class="fa-solid fa-plus mr-1"></i> メモ追加
                </button>
                <!-- Dark Mode Toggle -->
                <button onclick="toggleDarkMode()" class="p-2 rounded-lg bg-gray-800 text-amber-400 hover:bg-gray-700 active:scale-95 text-sm">
                    <i id="darkModeIcon" class="fa-solid fa-moon"></i>
                </button>
            </div>
        </header>

        <!-- MAIN CALENDAR HEADER & CONTROLS -->
        <section class="p-4 bg-gray-50 dark:bg-gray-900/60 border-b border-gray-200 dark:border-kyoto-borderDark">
            <!-- Month Navigation -->
            <div class="flex justify-between items-center mb-3">
                <button onclick="changeMonth(-1)" class="p-2 rounded-lg bg-white dark:bg-gray-800 shadow-sm border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-200 active:scale-95">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
                <div class="text-center">
                    <h2 id="currentMonthYear" class="text-lg font-bold tracking-wide text-gray-900 dark:text-white"></h2>
                    <span id="selectedDateDisplay" class="text-xs font-semibold text-amber-600 dark:text-amber-400"></span>
                </div>
                <button onclick="changeMonth(1)" class="p-2 rounded-lg bg-white dark:bg-gray-800 shadow-sm border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-200 active:scale-95">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>

            <!-- Calendar Days Grid -->
            <div class="grid grid-cols-7 gap-1 text-center text-xs mb-1 font-bold text-gray-500 dark:text-gray-400">
                <div class="text-red-500">日</div>
                <div>月</div>
                <div>火</div>
                <div>水</div>
                <div>木</div>
                <div>金</div>
                <div class="text-blue-500">土</div>
            </div>
            <div id="calendarDays" class="grid grid-cols-7 gap-1 text-sm">
                <!-- JS populated -->
            </div>
        </section>

        <!-- FILTERS SECTION (Collapsible / Scrollable) -->
        <section class="px-4 py-2.5 bg-gray-100 dark:bg-gray-900/90 border-b border-gray-200 dark:border-kyoto-borderDark">
            <!-- Category Chips -->
            <div class="mb-2">
                <div class="text-[11px] font-bold text-gray-500 dark:text-gray-400 mb-1 flex items-center">
                    <i class="fa-solid fa-filter mr-1 text-amber-500"></i> カテゴリ絞り込み
                </div>
                <div class="flex space-x-1.5 overflow-x-auto no-scrollbar py-0.5" id="categoryFilters">
                    <!-- Dynamic rendering -->
                </div>
            </div>

            <!-- Area Chips -->
            <div>
                <div class="text-[11px] font-bold text-gray-500 dark:text-gray-400 mb-1 flex items-center">
                    <i class="fa-solid fa-location-dot mr-1 text-red-500"></i> エリア絞り込み
                </div>
                <div class="flex space-x-1.5 overflow-x-auto no-scrollbar py-0.5" id="areaFilters">
                    <!-- Dynamic rendering -->
                </div>
            </div>
        </section>

        <!-- EVENT LIST SECTION -->
        <main class="flex-1 p-4 space-y-3">
            <div class="flex justify-between items-center mb-1">
                <h3 id="listTitle" class="font-bold text-sm text-gray-700 dark:text-gray-300 flex items-center">
                    <i class="fa-regular fa-calendar-check mr-1.5 text-amber-500"></i> 本日の催事・イベント
                </h3>
                <span id="eventCountBadge" class="text-xs font-semibold px-2 py-0.5 rounded-full bg-amber-100 dark:bg-amber-900/50 text-amber-800 dark:text-amber-300">0件</span>
            </div>

            <div id="eventList" class="space-y-3">
                <!-- Dynamic Event Cards Load Here -->
            </div>
        </main>

        <!-- FOOTER NAV / QUICK INFO -->
        <footer class="fixed bottom-0 left-0 right-0 max-w-md mx-auto bg-gray-900 text-gray-300 border-t border-gray-800 px-4 py-2 flex justify-between items-center z-20 text-xs">
            <div class="flex items-center space-x-3">
                <span class="flex items-center"><span class="w-2.5 h-2.5 rounded-full bg-red-500 inline-block mr-1"></span>高需要</span>
                <span class="flex items-center"><span class="w-2.5 h-2.5 rounded-full bg-amber-500 inline-block mr-1"></span>中需要</span>
                <span class="flex items-center"><span class="w-2.5 h-2.5 rounded-full bg-green-500 inline-block mr-1"></span>通常</span>
            </div>
            <button onclick="resetFilters()" class="text-amber-400 hover:text-amber-300 underline text-[11px]">
                条件リセット
            </button>
        </footer>

    </div>

    <!-- ADD CUSTOM EVENT MODAL -->
    <div id="addModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white dark:bg-gray-900 rounded-2xl max-w-sm w-full p-5 shadow-2xl border border-gray-200 dark:border-gray-800">
            <div class="flex justify-between items-center mb-4">
                <h3 class="font-bold text-lg text-gray-900 dark:text-white flex items-center">
                    <i class="fa-solid fa-pen-to-square text-amber-500 mr-2"></i> 自作メモ・催事追加
                </h3>
                <button onclick="closeAddModal()" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-lg">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            
            <form id="addEventForm" onsubmit="saveCustomEvent(event)" class="space-y-3 text-xs">
                <div>
                    <label class="block font-semibold mb-1 text-gray-700 dark:text-gray-300">日付</label>
                    <input type="date" id="modalDate" required class="w-full p-2.5 rounded-lg border border-gray-300 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white">
                </div>
                <div>
                    <label class="block font-semibold mb-1 text-gray-700 dark:text-gray-300">催事・イベント名</label>
                    <input type="text" id="modalTitle" placeholder="例：ウェスティン結婚式宴会（100名）" required class="w-full p-2.5 rounded-lg border border-gray-300 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white">
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block font-semibold mb-1 text-gray-700 dark:text-gray-300">時間帯</label>
                        <input type="text" id="modalTime" placeholder="例：18:00 - 21:00" required class="w-full p-2.5 rounded-lg border border-gray-300 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white">
                    </div>
                    <div>
                        <label class="block font-semibold mb-1 text-gray-700 dark:text-gray-300">需要予測レベル</label>
                        <select id="modalDemand" class="w-full p-2.5 rounded-lg border border-gray-300 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white">
                            <option value="High">高（特需・ピーク時集中）</option>
                            <option value="Medium" selected>中（定期的な実車増）</option>
                            <option value="Low">低（控えめ）</option>
                        </select>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block font-semibold mb-1 text-gray-700 dark:text-gray-300">カテゴリ</label>
                        <select id="modalCategory" class="w-full p-2.5 rounded-lg border border-gray-300 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white">
                            <option value="Hotel">ホテル・宴会・結婚式</option>
                            <option value="Conference">学会・展示会</option>
                            <option value="Festival">祭・伝統行事</option>
                            <option value="Event">コンサート・スポーツ</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-semibold mb-1 text-gray-700 dark:text-gray-300">エリア</label>
                        <select id="modalArea" class="w-full p-2.5 rounded-lg border border-gray-300 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white">
                            <option value="KyotoStation">京都駅周辺</option>
                            <option value="Okazaki">岡崎・東山</option>
                            <option value="Takaragaike">宝ヶ池・北山</option>
                            <option value="Shijo">四条・烏丸・河原町</option>
                            <option value="Fushimi">伏見・南区</option>
                            <option value="Other">その他</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block font-semibold mb-1 text-gray-700 dark:text-gray-300">会場名</label>
                    <input type="text" id="modalVenue" placeholder="例：ウェスティン都ホテル京都" required class="w-full p-2.5 rounded-lg border border-gray-300 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white">
                </div>
                <div>
                    <label class="block font-semibold mb-1 text-gray-700 dark:text-gray-300">乗務メモ（ピーク時間・付け付け位置等）</label>
                    <textarea id="modalNotes" rows="2" placeholder="例：20:30頃おひらき。タクシー乗り場混雑予想。" class="w-full p-2 rounded-lg border border-gray-300 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white"></textarea>
                </div>

                <div class="flex space-x-2 pt-2">
                    <button type="button" onclick="closeAddModal()" class="flex-1 py-2.5 rounded-xl border border-gray-300 dark:border-gray-700 font-bold text-gray-600 dark:text-gray-300">キャンセル</button>
                    <button type="submit" class="flex-1 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-gray-950 font-bold shadow-md">保存する</button>
                </div>
            </form>
        </div>
    </div>

    <!-- APPLICATION SCRIPT -->
    <script>
        // Default Pre-loaded Kyoto Events Database (2026 Season Focus)
        const initialKyotoEvents = [
            {
                id: 'k01',
                date: '2026-10-22',
                title: '時代祭（平安神宮・京都御苑）',
                category: 'Festival',
