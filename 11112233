                isCustom: false
            },
            {
                id: 'k02',
                date: '2026-10-22',
                title: '鞍馬の火祭',
                category: 'Festival',
                area: 'Takaragaike',
                venue: '由岐神社（鞍馬）',
                time: '18:00 - 24:00',
                attendance: '約15,000名',
                demand: 'High',
                notes: '出町柳駅・二軒茶屋・貴船口周辺への送り・迎え増加。深夜の出町柳駅周辺は終電溢れ客の長距離狙いポイント。',
                isCustom: false
            },
            {
                id: 'k03',
                date: '2026-10-20',
                title: '日本消化器病学会 学術集会',
                category: 'Conference',
                area: 'Takaragaike',
                venue: '国立京都国際会館',
                time: '08:30 - 18:00',
                attendance: '約4,500名',
                demand: 'High',
                notes: 'タクシー乗り場構内に行列発生予想。夕方17:00〜18:30に四条河原町・祇園方面への送り・分科会会場（ホテル）移動が集中。',
                isCustom: false
            },
            {
                id: 'k04',
                date: '2026-10-20',
                title: '京都先端技術見本市 2026',
                category: 'Conference',
                area: 'Okazaki',
                venue: 'みやこめっせ（京都国際勧業会館）',
                time: '10:00 - 17:00',
                attendance: '約3,000名',
                demand: 'Medium',
                notes: '16:30〜17:30の閉場時、東大路通や三条京阪方面への乗り込み増加。',
                isCustom: false
            },
            {
                id: 'k05',
                date: '2026-10-21',
                title: '関西経営者懇話会 創立記念祝賀会',
                category: 'Hotel',
                area: 'Okazaki',
                venue: 'ウェスティン都ホテル京都 (瑞穂の間)',
                time: '18:00 - 20:30',
                attendance: '約350名',
                demand: 'High',
                notes: 'ハイヤー・タクシー利用率が非常に高い役員系宴会。20:15頃から正面玄関前に付け待ち待機列有効。京都駅・四条方面多数。',
                isCustom: false
            },
            {
                id: 'k06',
                date: '2026-10-21',
                title: '秋の特別拝観 ライトアップ初日',
                category: 'Festival',
                area: 'Okazaki',
                venue: '高台寺・清水寺周辺',
                time: '17:30 - 21:30',
                attendance: '多数',
                demand: 'Medium',
                notes: '東大路通・五条坂周辺で拾い需要高。四条河原町・京都駅方面への送迎需要多し。',
                isCustom: false
            },
            {
                id: 'k07',
                date: '2026-10-24',
                title: '大規模医薬品メーカー 年次総会・宴会',
                category: 'Hotel',
                area: 'KyotoStation',
                venue: 'リーガロイヤルホテル京都',
                time: '17:00 - 20:00',
                attendance: '約250名',
                demand: 'High',
                notes: 'おひらき直後の20:00前後、京都駅八条口・伊丹空港リムジンバス乗り場、ならびに市内二次会（祇園）への送り需要集中。',
                isCustom: false
            },
            {
                id: 'k08',
                date: '2026-10-25',
                title: '人気ロックバンド 全国アリーナツアー',
                category: 'Event',
                area: 'Fushimi',
                venue: '京都パルスプラザ（大展示場）',
                time: '16:00 - 19:00',
                attendance: '約8,000名',
                demand: 'High',
                notes: '終演後の19:00〜20:30、竹田駅および京都駅行きのタクシー待機列大。油小路通の混雑に注意。',
                isCustom: false
            },
            {
                id: 'k09',
                date: '2026-10-28',
                title: '京都ホテルオークラ 秋のブライダルフェア＆賞与パーティ',
                category: 'Hotel',
                area: 'Shijo',
                venue: '京都ホテルオークラ',
                time: '11:00 - 19:30',
                attendance: '約400名',
                demand: 'Medium',
                notes: '河原町御池交差点付近での乗降多し。地下駐車場待機または御池通沿いのタクシー乗り場が効果的。',
                isCustom: false
            }
        ];

        // App State
        let currentDate = new Date(2026, 9, 20); // Default set to Oct 20, 2026 for rich demo display
        let selectedDateStr = '2026-10-20';
        let selectedCategory = 'ALL';
        let selectedArea = 'ALL';
        let eventsData = [];

        // Categories Configuration
        const categories = {
            'ALL': 'すべて',
            'Hotel': 'ホテル・宴会',
            'Conference': '学会・展示会',
            'Festival': '祭・伝統行事',
            'Event': 'ライブ・催事'
        };

        // Areas Configuration
        const areas = {
            'ALL': '全エリア',
            'KyotoStation': '京都駅周辺',
            'Okazaki': '岡崎・東山',
            'Takaragaike': '宝ヶ池・北山',
            'Shijo': '四条・烏丸・河原町',
            'Fushimi': '伏見・南区'
        };

        // Initialize App
        window.onload = function() {
            loadEvents();
            renderFilters();
            renderCalendar();
            renderEventList();
            
            // Set default date in modal
            document.getElementById('modalDate').value = selectedDateStr;
        };

        // Load & Sync LocalStorage Events
        function loadEvents() {
            const stored = localStorage.getItem('kyoto_taxi_events');
            if (stored) {
                try {
                    eventsData = JSON.parse(stored);
                } catch(e) {
                    eventsData = [...initialKyotoEvents];
                }
            } else {
                eventsData = [...initialKyotoEvents];
                localStorage.setItem('kyoto_taxi_events', JSON.stringify(eventsData));
            }
        }

        function saveEventsToStorage() {
            localStorage.setItem('kyoto_taxi_events', JSON.stringify(eventsData));
        }

        // Dark Mode Toggle
        function toggleDarkMode() {
            const isDark = document.documentElement.classList.toggle('dark');
            const icon = document.getElementById('darkModeIcon');
            if (isDark) {
                icon.className = 'fa-solid fa-sun text-amber-400';
            } else {
                icon.className = 'fa-solid fa-moon text-amber-400';
            }
        }

        // Render Category and Area Filter Chips
        function renderFilters() {
            const catContainer = document.getElementById('categoryFilters');
            catContainer.innerHTML = Object.entries(categories).map(([key, label]) => `
                <button onclick="setCategoryFilter('${key}')" class="px-2.5 py-1 rounded-full text-xs font-semibold whitespace-nowrap transition-all ${
                    selectedCategory === key 
                    ? 'bg-amber-500 text-gray-950 font-bold shadow-sm' 
                    : 'bg-white dark:bg-gray-800 text-gray-600 dark:text-gray-300 border border-gray-200 dark:border-gray-700'
                }">
                    ${label}
                </button>
            `).join('');

            const areaContainer = document.getElementById('areaFilters');
            areaContainer.innerHTML = Object.entries(areas).map(([key, label]) => `
                <button onclick="setAreaFilter('${key}')" class="px-2.5 py-1 rounded-full text-xs font-semibold whitespace-nowrap transition-all ${
                    selectedArea === key 
                    ? 'bg-red-600 text-white font-bold shadow-sm' 
                    : 'bg-white dark:bg-gray-800 text-gray-600 dark:text-gray-300 border border-gray-200 dark:border-gray-700'
                }">
                    ${label}
                </button>
            `).join('');
        }

        function setCategoryFilter(cat) {
            selectedCategory = cat;
            renderFilters();
            renderEventList();
        }

        function setAreaFilter(area) {
            selectedArea = area;
            renderFilters();
            renderEventList();
        }

        function resetFilters() {
            selectedCategory = 'ALL';
            selectedArea = 'ALL';
            renderFilters();
            renderEventList();
        }

        // Calendar Logic
        function changeMonth(delta) {
            currentDate.setMonth(currentDate.getMonth() + delta);
            renderCalendar();
        }

        function renderCalendar() {
            const year = currentDate.getFullYear();
            const month = currentDate.getMonth();

            // Display Title
            document.getElementById('currentMonthYear').textContent = `${year}年 ${month + 1}月`;
            
            const firstDay = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();

            const calendarDays = document.getElementById('calendarDays');
            calendarDays.innerHTML = '';

            // Empty Cells before Month Start
            for (let i = 0; i < firstDay; i++) {
                const emptyCell = document.createElement('div');
                emptyCell.className = 'h-10 rounded-lg bg-transparent';
                calendarDays.appendChild(emptyCell);
            }

            // Days rendering
            for (let day = 1; day <= daysInMonth; day++) {
                const dayStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                
                // Count events for this day
                const dayEvents = eventsData.filter(e => e.date === dayStr);
                const hasHighDemand = dayEvents.some(e => e.demand === 'High');

                const isSelected = (dayStr === selectedDateStr);
                const isToday = (dayStr === new Date().toISOString().split('T')[0]);

                const cell = document.createElement('button');
                cell.onclick = () => selectDate(dayStr);

                let bgClass = 'bg-white dark:bg-gray-800 text-gray-800 dark:text-gray-200 border border-gray-100 dark:border-gray-800';
                if (isSelected) {
                    bgClass = 'bg-amber-500 text-gray-950 font-extrabold ring-2 ring-amber-400 dark:ring-amber-500 shadow-md';
                } else if (isToday) {
                    bgClass = 'border-2 border-amber-500 text-amber-600 dark:text-amber-400 font-bold';
                }

                cell.className = `h-10 rounded-xl p-1 flex flex-col justify-between items-center transition-all relative ${bgClass}`;

                cell.innerHTML = `
                    <span class="text-xs leading-none">${day}</span>
                    <div class="flex items-center space-x-0.5">
                        ${dayEvents.length > 0 ? `
                            <span class="w-1.5 h-1.5 rounded-full ${hasHighDemand ? 'bg-red-500 animate-pulse' : 'bg-amber-500'}"></span>
                            ${dayEvents.length > 1 ? `<span class="text-[9px] scale-75 opacity-75">${dayEvents.length}</span>` : ''}
                        ` : ''}
                    </div>
                `;

                calendarDays.appendChild(cell);
            }

            // Update Header Display
            const [y, m, d] = selectedDateStr.split('-');
            document.getElementById('selectedDateDisplay').textContent = `選択中: ${y}年${parseInt(m)}月${parseInt(d)}日`;
        }

        function selectDate(dateStr) {
            selectedDateStr = dateStr;
            document.getElementById('modalDate').value = dateStr;
            renderCalendar();
            renderEventList();
        }

        // Render Event List for Selected Date & Filters
        function renderEventList() {
            const listContainer = document.getElementById('eventList');
            const countBadge = document.getElementById('eventCountBadge');
            
            const [y, m, d] = selectedDateStr.split('-');
            document.getElementById('listTitle').innerHTML = `
                <i class="fa-regular fa-calendar-check mr-1.5 text-amber-500"></i> ${parseInt(m)}月${parseInt(d)}日の催事・需要
            `;

            // Filter logic
            const filtered = eventsData.filter(e => {
                const matchDate = (e.date === selectedDateStr);
                const matchCat = (selectedCategory === 'ALL' || e.category === selectedCategory);
                const matchArea = (selectedArea === 'ALL' || e.area === selectedArea);
                return matchDate && matchCat && matchArea;
            });

            countBadge.textContent = `${filtered.length}件`;

            if (filtered.length === 0) {
                listContainer.innerHTML = `
                    <div class="text-center py-10 bg-gray-50 dark:bg-gray-900/40 rounded-2xl border border-dashed border-gray-300 dark:border-gray-800">
                        <i class="fa-solid fa-calendar-xmark text-3xl text-gray-300 dark:text-gray-700 mb-2"></i>
                        <p class="text-xs text-gray-500 dark:text-gray-400 font-medium">該当する催事・イベント情報はありません</p>
                        <button onclick="openAddModal()" class="mt-3 text-xs bg-amber-500/10 text-amber-600 dark:text-amber-400 px-3 py-1.5 rounded-lg font-bold border border-amber-500/20">
                            + 自分でメモ・予定を追加
                        </button>
                    </div>
                `;
                return;
            }

            listContainer.innerHTML = filtered.map(item => {
                // Demand Badge Setup
                let demandBadge = '';
                if (item.demand === 'High') {
                    demandBadge = '<span class="bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/30 text-[10px] px-2 py-0.5 rounded-md font-bold"><i class="fa-solid fa-fire mr-1"></i>高需要・特需</span>';
                } else if (item.demand === 'Medium') {
                    demandBadge = '<span class="bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/30 text-[10px] px-2 py-0.5 rounded-md font-bold">中需要</span>';
                } else {
                    demandBadge = '<span class="bg-green-500/10 text-green-600 dark:text-green-400 border border-green-500/30 text-[10px] px-2 py-0.5 rounded-md font-bold">通常</span>';
                }

                // Category Name
                const catName = categories[item.category] || 'その他';
                const areaName = areas[item.area] || 'その他エリア';

                // Google Map Navigation URL
                const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(item.venue + ' 京都市')}`;

                return `
                    <div class="bg-white dark:bg-kyoto-cardDark border border-gray-200 dark:border-kyoto-borderDark rounded-2xl p-4 shadow-sm relative transition-all hover:border-amber-500/50">
                        <div class="flex justify-between items-start mb-2">
                            <div class="flex items-center space-x-1.5 flex-wrap gap-y-1">
                                <span class="bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 text-[10px] px-2 py-0.5 rounded-md font-semibold">${catName}</span>
                                <span class="bg-blue-50 dark:bg-blue-950/50 text-blue-600 dark:text-blue-300 border border-blue-200 dark:border-blue-900 text-[10px] px-2 py-0.5 rounded-md font-semibold">${areaName}</span>
                                ${demandBadge}
                            </div>
                            ${item.isCustom ? `
                                <button onclick="deleteCustomEvent('${item.id}')" class="text-gray-400 hover:text-red-500 p-1 text-xs">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            ` : ''}
                        </div>

                        <h4 class="font-bold text-base text-gray-900 dark:text-white leading-snug mb-1">
                            ${item.title}
                        </h4>

                        <div class="space-y-1 my-2 text-xs text-gray-600 dark:text-gray-300">
                            <div class="flex items-center">
                                <i class="fa-regular fa-clock w-4 text-amber-500"></i>
                                <span class="font-semibold">${item.time}</span>
                                ${item.attendance ? `<span class="ml-2 text-gray-400">(${item.attendance})</span>` : ''}
                            </div>
                            <div class="flex items-center">
                                <i class="fa-solid fa-location-dot w-4 text-red-500"></i>
                                <span class="font-bold text-gray-800 dark:text-gray-200">${item.venue}</span>
                            </div>
                        </div>

                        ${item.notes ? `
                            <div class="mt-2 p-2.5 bg-amber-500/5 dark:bg-amber-500/10 border-l-2 border-amber-500 rounded-r-lg text-xs text-gray-700 dark:text-gray-300">
                                <span class="font-bold text-amber-600 dark:text-amber-400"><i class="fa-solid fa-lightbulb mr-1"></i>乗務メモ・立ち回り:</span>
                                ${item.notes}
                            </div>
                        ` : ''}

                        <div class="mt-3 flex justify-end">
                            <a href="${mapUrl}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-3 py-1.5 rounded-xl bg-gray-100 hover:bg-gray-200 dark:bg-gray-800 dark:hover:bg-gray-700 text-blue-600 dark:text-blue-400 text-xs font-bold transition-all border border-gray-200 dark:border-gray-700">
                                <i class="fa-solid fa-diamond-turn-right mr-1.5"></i> Googleマップでナビ
                            </a>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // Custom Event Add & Delete Handlers
        function openAddModal() {
            document.getElementById('addModal').classList.remove('hidden');
        }

        function closeAddModal() {
            document.getElementById('addModal').classList.add('hidden');
        }

        function saveCustomEvent(e) {
            e.preventDefault();

            const newEvent = {
                id: 'custom_' + Date.now(),
                date: document.getElementById('modalDate').value,
                title: document.getElementById('modalTitle').value,
                time: document.getElementById('modalTime').value,
                demand: document.getElementById('modalDemand').value,
                category: document.getElementById('modalCategory').value,
                area: document.getElementById('modalArea').value,
                venue: document.getElementById('modalVenue').value,
                notes: document.getElementById('modalNotes').value,
                attendance: '自作メモ',
                isCustom: true
            };

            eventsData.push(newEvent);
            saveEventsToStorage();

            // Refresh UI
            selectDate(newEvent.date);
            closeAddModal();

            // Reset Form Inputs
            document.getElementById('addEventForm').reset();
            document.getElementById('modalDate').value = selectedDateStr;
        }

        function deleteCustomEvent(id) {
            if (confirm('この自作メモ・催事情報を削除しますか？')) {
                eventsData = eventsData.filter(e => e.id !== id);
                saveEventsToStorage();
                renderCalendar();
                renderEventList();
            }
        }
    </script>
</body>
</html>
